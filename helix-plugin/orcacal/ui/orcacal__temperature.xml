<?xml version="1.0"?>
<component>
  <!-- A second native overlay makes Temperature a module/detail, not the shell.
       The inherited Back control returns to the chooser. -->
  <view name="orcacal__temperature" extends="overlay_panel" title="Temperature" bg_color="#screen_bg">
    <lv_obj name="orcacal__temperature_content" width="100%" flex_grow="1" flex_flow="column" scrollable="true"
            style_pad_all="#space_md" style_pad_gap="#space_md"
            style_bg_opa="0" style_border_width="0">
      <ui_card width="100%" height="content" flex_flow="column"
               style_pad_all="#space_md" style_pad_gap="#space_xs">
        <text_small width="100%" text="USING" style_text_color="#text_muted"/>
        <text_body width="100%" text="Voron 2.4 300" long_mode="wrap"/>
        <text_small width="100%" text="Generic PLA - Rapido · 0.4 mm" long_mode="wrap"
                    style_text_color="#text_muted"/>
        <text_small width="100%" text="Fast Quality" long_mode="wrap"
                    style_text_color="#text_muted"/>
      </ui_card>

      <ui_card width="100%" height="content" flex_flow="column"
               style_pad_all="#space_md" style_pad_gap="#space_sm">
        <lv_obj width="100%" height="content" flex_flow="row" scrollable="false"
                style_pad_all="0" style_pad_gap="#space_sm" style_flex_cross_place="center"
                style_bg_opa="0" style_border_width="0">
          <icon src="thermometer_lines" size="md" variant="primary"/>
          <text_heading width="0" flex_grow="1" text="Temperature range" long_mode="wrap"/>
        </lv_obj>
        <lv_obj width="100%" height="content" flex_flow="row" scrollable="false"
                style_pad_all="0" style_pad_gap="#space_sm"
                style_flex_main_place="center" style_flex_cross_place="center"
                style_bg_opa="0" style_border_width="0">
          <lv_label text="230°C" style_text_font="#font_xl" style_text_color="#text"/>
          <icon src="arrow_right" size="md" variant="muted"/>
          <lv_label text="190°C" style_text_font="#font_xl" style_text_color="#text"/>
        </lv_obj>
      </ui_card>

      <!-- ui_button is not in beta.4's plugin allowlist. This allowed LVGL
           button uses Helix's responsive action tokens. -->
      <lv_button name="orcacal__start_button" width="100%" height="#button_height"
                 style_bg_color="#primary" style_bg_opa="255"
                 style_radius="#border_radius" style_border_width="0"
                 style_shadow_width="0">
        <event_cb trigger="clicked" callback="plugin_event" user_data="orcacal__start"/>
        <lv_label width="100%" text="Start" style_text_align="center"
                  style_text_font="#font_body_bold" style_text_color="#text_on_primary"/>
      </lv_button>
    </lv_obj>
  </view>
</component>
