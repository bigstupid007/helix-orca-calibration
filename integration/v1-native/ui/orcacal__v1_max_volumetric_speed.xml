<?xml version='1.0' encoding='utf-8'?>
<component>
  <view name="orcacal__v1_max_volumetric_speed" extends="overlay_panel" title="Max Volumetric Speed" bg_color="#screen_bg">
    <lv_obj name="orcacal__v1_v1_max_volumetric_speed_content" width="100%" flex_grow="1" flex_flow="column" scrollable="true" style_pad_all="#space_md" style_pad_gap="#space_sm" style_bg_opa="0" style_border_width="0">
      <ui_card width="100%" height="content" flex_flow="column" scrollable="false" style_pad_all="#space_sm" style_pad_gap="#space_xs">
        <text_small width="100%" text="CURRENT CONTEXT" long_mode="wrap" />
        <text_body width="100%" bind_text="orcacal__v1_printer" long_mode="wrap" />
        <text_small width="100%" bind_text="orcacal__v1_profiles" long_mode="wrap" />
        <text_xs width="100%" bind_text="orcacal__v1_context_note" long_mode="wrap" />
      </ui_card>
      <text_heading width="100%" text="Tower" long_mode="wrap" />
      <text_small width="100%" text="Find the highest clean flow region after successful completion." long_mode="wrap" />
      <text_small width="100%" bind_text="orcacal__v1_availability_max_volumetric_speed" long_mode="wrap" />
      <text_small width="100%" text="Starting flow (mm³/s)" long_mode="wrap" />
      <lv_dropdown name="orcacal__v1_max_volumetric_speed_start" width="100%" options="5&#10;2&#10;3&#10;8&#10;10" bind_value="orcacal__v1_max_volumetric_speed_start_idx" />
      <text_small width="100%" text="Ending flow (mm³/s)" long_mode="wrap" />
      <lv_dropdown name="orcacal__v1_max_volumetric_speed_end" width="100%" options="20&#10;15&#10;25&#10;30&#10;40" bind_value="orcacal__v1_max_volumetric_speed_end_idx" />
      <text_small width="100%" text="Flow increment (mm³/s)" long_mode="wrap" />
      <lv_dropdown name="orcacal__v1_max_volumetric_speed_step" width="100%" options="0.5&#10;1&#10;2" bind_value="orcacal__v1_max_volumetric_speed_step_idx" />
      <text_small width="100%" text="Preparation does not start a print. Review the prepared job before confirming." long_mode="wrap" />
      <lv_button name="orcacal__v1_generate_max_volumetric_speed" width="100%" height="#button_height" style_bg_color="#primary" style_bg_opa="255" style_radius="#border_radius" style_border_width="0" style_shadow_width="0">
        <event_cb trigger="clicked" callback="plugin_event" user_data="orcacal__v1_generate:max_volumetric_speed" />
        <lv_label width="100%" text="Request generation" style_text_align="center" style_text_font="#font_body_bold" style_text_color="#text_on_primary" />
      </lv_button>
      <text_small width="100%" bind_text="orcacal__v1_message" long_mode="wrap" />
    </lv_obj>
  </view>
</component>