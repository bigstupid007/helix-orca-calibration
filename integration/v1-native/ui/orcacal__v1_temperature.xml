<?xml version='1.0' encoding='utf-8'?>
<component>
  <view name="orcacal__v1_temperature" extends="overlay_panel" title="Temperature" bg_color="#screen_bg">
    <lv_obj name="orcacal__v1_v1_temperature_content" width="100%" flex_grow="1" flex_flow="column" scrollable="true" style_pad_all="#space_md" style_pad_gap="#space_sm" style_bg_opa="0" style_border_width="0">
      <ui_card width="100%" height="content" flex_flow="column" scrollable="false" style_pad_all="#space_sm" style_pad_gap="#space_xs">
        <text_small width="100%" text="CURRENT CONTEXT" long_mode="wrap" />
        <text_body width="100%" bind_text="orcacal__v1_printer" long_mode="wrap" />
        <text_small width="100%" bind_text="orcacal__v1_profiles" long_mode="wrap" />
        <text_xs width="100%" bind_text="orcacal__v1_context_note" long_mode="wrap" />
      </ui_card>
      <text_heading width="100%" text="Standard tower" long_mode="wrap" />
      <text_small width="100%" text="Choose a temperature range. Evaluate the cleanest band after successful completion." long_mode="wrap" />
      <text_small width="100%" bind_text="orcacal__v1_availability_temperature" long_mode="wrap" />
      <text_small width="100%" text="Starting temperature (°C)" long_mode="wrap" />
      <lv_dropdown name="orcacal__v1_temperature_start" width="100%" options="230&#10;240&#10;250&#10;260&#10;270&#10;280&#10;220&#10;210&#10;200" bind_value="orcacal__v1_temperature_start_idx" />
      <text_small width="100%" text="Ending temperature (°C)" long_mode="wrap" />
      <lv_dropdown name="orcacal__v1_temperature_end" width="100%" options="190&#10;200&#10;210&#10;220&#10;230&#10;240&#10;250" bind_value="orcacal__v1_temperature_end_idx" />
      <text_small width="100%" text="Temperature step (°C)" long_mode="wrap" />
      <lv_dropdown name="orcacal__v1_temperature_step" width="100%" options="5" bind_value="orcacal__v1_temperature_step_idx" />
      <text_small width="100%" text="Scale tower" long_mode="wrap" />
      <lv_dropdown name="orcacal__v1_temperature_scale" width="100%" options="Off&#10;On" bind_value="orcacal__v1_temperature_scale_idx" />
      <text_small width="100%" text="Preparation does not start a print. Review the prepared job before confirming." long_mode="wrap" />
      <lv_button name="orcacal__v1_generate_temperature" width="100%" height="#button_height" style_bg_color="#primary" style_bg_opa="255" style_radius="#border_radius" style_border_width="0" style_shadow_width="0">
        <event_cb trigger="clicked" callback="plugin_event" user_data="orcacal__v1_generate:temperature" />
        <lv_label width="100%" text="Request generation" style_text_align="center" style_text_font="#font_body_bold" style_text_color="#text_on_primary" />
      </lv_button>
      <text_small width="100%" bind_text="orcacal__v1_message" long_mode="wrap" />
    </lv_obj>
  </view>
</component>