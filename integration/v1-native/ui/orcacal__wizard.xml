<?xml version='1.0' encoding='utf-8'?>
<component>
  <view name="orcacal__wizard" extends="overlay_panel" title="Orca Calibration" bg_color="#screen_bg">
    <lv_obj name="orcacal__v1_wizard_content" width="100%" flex_grow="1" flex_flow="column" scrollable="true" style_pad_all="#space_md" style_pad_gap="#space_sm" style_bg_opa="0" style_border_width="0">
      <ui_card width="100%" height="content" flex_flow="column" scrollable="false" style_pad_all="#space_sm" style_pad_gap="#space_xs">
        <text_small width="100%" text="CURRENT CONTEXT" long_mode="wrap" />
        <text_body width="100%" bind_text="orcacal__v1_offer_printer" long_mode="wrap" />
        <text_small width="100%" bind_text="orcacal__v1_offer_profiles" long_mode="wrap" />
        <text_xs width="100%" bind_text="orcacal__v1_offer_note" long_mode="wrap" />
      </ui_card>
      <text_small width="100%" text="CHOOSE CALIBRATION" long_mode="wrap" />
      <text_small width="100%" bind_text="orcacal__v1_message" long_mode="wrap" />
      <lv_button name="orcacal__v1_choose_temperature" width="100%" height="#button_height" style_bg_color="#primary" style_bg_opa="255" style_radius="#border_radius" style_border_width="0" style_shadow_width="0">
        <event_cb trigger="clicked" callback="plugin_event" user_data="orcacal__v1_choose:temperature" />
        <lv_label width="100%" text="Temperature · Standard tower" style_text_align="center" style_text_font="#font_body_bold" style_text_color="#text_on_primary" />
      </lv_button>
      <text_xs width="100%" bind_text="orcacal__v1_availability_temperature" long_mode="wrap" />
      <lv_button name="orcacal__v1_choose_flow_ratio_yolo" width="100%" height="#button_height" style_bg_color="#primary" style_bg_opa="255" style_radius="#border_radius" style_border_width="0" style_shadow_width="0">
        <event_cb trigger="clicked" callback="plugin_event" user_data="orcacal__v1_choose:flow_ratio_yolo" />
        <lv_label width="100%" text="Flow Ratio · YOLO" style_text_align="center" style_text_font="#font_body_bold" style_text_color="#text_on_primary" />
      </lv_button>
      <text_xs width="100%" bind_text="orcacal__v1_availability_flow_ratio_yolo" long_mode="wrap" />
      <lv_button name="orcacal__v1_choose_pressure_advance_pattern" width="100%" height="#button_height" style_bg_color="#primary" style_bg_opa="255" style_radius="#border_radius" style_border_width="0" style_shadow_width="0">
        <event_cb trigger="clicked" callback="plugin_event" user_data="orcacal__v1_choose:pressure_advance_pattern" />
        <lv_label width="100%" text="Pressure Advance · Pattern" style_text_align="center" style_text_font="#font_body_bold" style_text_color="#text_on_primary" />
      </lv_button>
      <text_xs width="100%" bind_text="orcacal__v1_availability_pressure_advance_pattern" long_mode="wrap" />
      <lv_button name="orcacal__v1_choose_retraction" width="100%" height="#button_height" style_bg_color="#primary" style_bg_opa="255" style_radius="#border_radius" style_border_width="0" style_shadow_width="0">
        <event_cb trigger="clicked" callback="plugin_event" user_data="orcacal__v1_choose:retraction" />
        <lv_label width="100%" text="Retraction · Tower" style_text_align="center" style_text_font="#font_body_bold" style_text_color="#text_on_primary" />
      </lv_button>
      <text_xs width="100%" bind_text="orcacal__v1_availability_retraction" long_mode="wrap" />
      <lv_button name="orcacal__v1_choose_max_volumetric_speed" width="100%" height="#button_height" style_bg_color="#primary" style_bg_opa="255" style_radius="#border_radius" style_border_width="0" style_shadow_width="0">
        <event_cb trigger="clicked" callback="plugin_event" user_data="orcacal__v1_choose:max_volumetric_speed" />
        <lv_label width="100%" text="Max Volumetric Speed · Tower" style_text_align="center" style_text_font="#font_body_bold" style_text_color="#text_on_primary" />
      </lv_button>
      <text_xs width="100%" bind_text="orcacal__v1_availability_max_volumetric_speed" long_mode="wrap" />
      <lv_button name="orcacal__v1_resume" width="100%" height="#button_height" style_bg_color="#primary" style_bg_opa="255" style_radius="#border_radius" style_border_width="0" style_shadow_width="0">
        <bind_flag_if_eq subject="orcacal__v1_resume_on" flag="hidden" ref_value="0" />
        <event_cb trigger="clicked" callback="plugin_event" user_data="orcacal__v1_resume" />
        <lv_label width="100%" text="Open calibration" style_text_align="center" style_text_font="#font_body_bold" style_text_color="#text_on_primary" />
      </lv_button>
    </lv_obj>
  </view>
</component>