<?xml version="1.0"?>
<component>
  <view name="orcacal__tile" extends="lv_obj"
        width="100%" height="100%" clickable="true" scrollable="false"
        style_pad_all="0">
    <event_cb trigger="clicked" callback="plugin_event" user_data="orcacal__open"/>
    <icon name="orcacal__tile_icon" src="tune" size="xs" variant="primary"
          align="top_mid" clickable="false" event_bubble="true"/>
    <text_tiny name="orcacal__tile_identity" text="Orca&#10;Calibration"
               align="center" y="1" style_text_align="center" clickable="false" event_bubble="true"/>
    <text_tiny name="orcacal__tile_status" bind_text="orcacal__tp_tile_status"
               align="bottom_mid" style_text_align="center" style_text_color="#text_muted"
               clickable="false" event_bubble="true"/>
  </view>
</component>
